# Collaboration and feedback storage: local keeps data in the browser (preview). api needs the ProofCraft backend.
VITE_COLLAB_DRIVER=local
VITE_API_BASE_URL=
# Google sign-in. Create an OAuth client (Web), add your site origins, paste the client ID. Leave empty to show the button disabled.
VITE_GOOGLE_CLIENT_ID=
# Comma-separated admin emails (client-side hint only; the server must enforce admin access).
VITE_ADMIN_EMAILS=
# Preview only: lets any tester switch admin tools on from Settings. Never set in production.
VITE_PREVIEW_ADMIN=0
# Set to 0 to stop asking the optional "money is a challenge" question (Egypt PDPL treats financial data as sensitive).
VITE_COLLECT_HARDSHIP=1
